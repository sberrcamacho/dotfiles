{
  "Main guard": {
    "prefix": "main",
    "body": [
      "def main():",
      "    ${1:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ]
  },
  "Dataclass": {
    "prefix": "dcls",
    "body": [
      "@dataclass",
      "class ${1:Name}:",
      "    ${2:field}: ${3:str}"
    ]
  },
  "Try/except": {
    "prefix": "tryex",
    "body": [
      "try:",
      "    ${1:pass}",
      "except ${2:Exception} as e:",
      "    ${3:raise}"
    ]
  },
  "With open": {
    "prefix": "wopen",
    "body": [
      "with open(${1:path}, \"${2:r}\") as f:",
      "    ${3:data = f.read()}"
    ]
  },
  "Pytest test": {
    "prefix": "test",
    "body": [
      "def test_${1:name}():",
      "    assert ${2:True}"
    ]
  }
}
