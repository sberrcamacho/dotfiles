// --- Configuration: Window Rules ---
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Terminales apiladas: nunca más bajas de 200 px (Zen no baja de ~490 px y las aplastaba)
window-rule {
    match app-id="kitty"
    min-height 200
}

// Minimal: las ventanas sin foco se atenúan (se ve el blur detrás)
window-rule {
    match is-active=false
    opacity 0.93
}

/* Apps: blur them all without xray for a better look */
window-rule {
  background-effect {
    blur true
    xray false
  }
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Noctalia v5: wallpaper on the backdrop (visible in overview).
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Noctalia v5: blur shell surfaces without xray.
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

// Android Emulator (X11 vía xwayland-satellite): flotante para que niri no
// lo redimensione (si no, el contenido queda pegado a la izquierda y el resto gris).
// No siempre aplica (satellite fija el app-id tarde): scripts/emulator-float.py lo garantiza.
window-rule {
    match app-id="^Emulator$"
    open-floating true
}
