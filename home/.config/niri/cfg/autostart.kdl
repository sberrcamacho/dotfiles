// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    // polkit: handled by noctalia v5 built-in agent ([shell] polkit_agent = true)
    spawn-at-startup "noctalia"
    spawn-sh-at-startup "easyeffects --gapplication-service"
    // Máximo 2 ventanas apiladas por columna; con 3 o más → pestañas
    spawn-sh-at-startup "~/.config/niri/scripts/auto-tab.py"
    // Android Emulator: barra lateral en la columna de la derecha del emulador
    spawn-sh-at-startup "~/.config/niri/scripts/emulator-toolbar.py"
