// --- CachyOS ---
include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction

// ========================================================
// ========================================================

// -- Configuration: Gestures ---
// https://github.com/YaLTeR/niri/wiki/Configuration:-Gestures

gestures {
  hot-corners {
    off
  }
}

// ========================================================
// ========================================================

// -- Configuration: Layout ---
// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout

layout {
    gaps 8
    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 3
    }

    shadow {
        on
        softness 30
        spread 5

        offset x=0 y=5
        color "#0007"
    }
}

// ========================================================
// ========================================================

include "./noctalia.kdl"



